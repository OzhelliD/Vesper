# ════════════════════════════════════════════════════════════════════════════════
# VESPER — Agente Personal Inteligente de Ozhelli
# Configuración para Railway
# ════════════════════════════════════════════════════════════════════════════════

# ── DATABASE (Requerido) ───────────────────────────────────────────────────────────
# Railway proporciona esto automáticamente, pero si necesitas conectar manualmente:
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/vesper

# ── ANTHROPIC API (Requerido) ──────────────────────────────────────────────────────
# Obtener en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── CLIMA ──────────────────────────────────────────────────────────────────────────
# Opcional. Obtener en https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── SPOTIFY (Opcional) ─────────────────────────────────────────────────────────────
# Para reproducción de música. Obtener en https://developer.spotify.com/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Railway URL: https://tu-app.railway.app
SPOTIFY_REDIRECT_URI=https://tu-app.railway.app/spotify/callback

# ── BÚSQUEDA (Opcional) ────────────────────────────────────────────────────────────
# Para búsqueda avanzada. Obtener en:
TAVILY_API_KEY=
SERPAPI_KEY=

# ── IMÁGENES (Opcional) ────────────────────────────────────────────────────────────
# Para búsqueda de imágenes. Obtener en https://pixabay.com/api/
PIXABAY_KEY=

# ── SEGURIDAD ──────────────────────────────────────────────────────────────────────
# PIN para acceso restringido (32 caracteres recomendado)
OWNER_PIN=

# ── PUERTO ─────────────────────────────────────────────────────────────────────────
# Railway proporciona PORT automáticamente (8080)
# PORT=8080

# ── OTHERS ─────────────────────────────────────────────────────────────────────────
# URL externa de Railway (se establece automáticamente)
# RENDER_EXTERNAL_URL=https://tu-app.railway.app

# Keep-alive (para Render, no necesario en Railway)
# ENABLE_KEEP_ALIVE=false
