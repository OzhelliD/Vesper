# ─────────────────────────────────────────────────────────────────────────────
# VESPER - Variables de Entorno
# Copia este archivo a .env y relena los valores correspondientes
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUERIDO ═══════════════════════════════════════════════════════════════

# PostgreSQL Database Connection
# Formato: postgresql://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://user:password@localhost:5432/vesper

# Hugging Face API Key - Obtén en: https://huggingface.co/settings/tokens
HF_API_KEY=hf_TuTokenAquiDe32CaracteresAlMenos

# ═══ OPCIONAL - APIs Externas ════════════════════════════════════════════════

# OpenWeather API - Para obtener clima detallado
# Obtén en: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Tavily Search API - Para búsqueda web mejorada
# Obtén en: https://tavily.com/
TAVILY_API_KEY=

# ═══ OPCIONAL - Spotify ══════════════════════════════════════════════════════

# Spotify Developer Credentials
# Obtén en: https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/spotify/callback

# Scopes de Spotify (déjalo así si no sabes)
SPOTIFY_SCOPES=playlist-modify-public playlist-modify-private user-read-playback-state user-modify-playback-state streaming

# ═══ OPCIONAL - Configuración General ════════════════════════════════════════

# Pin de seguridad para acceso propietario (dejar en blanco para desactivar)
OWNER_PIN=

# Nombre del propietario
OWNER_NAME=Ozhelli

# Puerto donde escucha la aplicación
PORT=8080

# ═══ NOTAS ═══════════════════════════════════════════════════════════════════
# 
# 1. DATABASE_URL y HF_API_KEY son REQUERIDAS, el resto es opcional
#
# 2. Ejemplos de DATABASE_URL:
#    - Local:    postgresql://postgres:password@localhost/vesper
#    - Railway:  postgresql://user:pass@containers-us-west-XX.railway.app/railway
#    - Render:   postgresql://user:pass@dpg-XXXXX.postgres.render.com/vesper
#
# 3. El archivo .env NUNCA debe ser incluido en Git (está en .gitignore)
#
# 4. En producción, usa variables de entorno del sistema en lugar de .env
#
# 5. Cambiar HF_MODEL_ID en main.py para usar otros modelos:
#    - meta-llama/Llama-2-7b-chat-hf (actual)
#    - meta-llama/Llama-2-70b-chat-hf (más grande)
#    - mistralai/Mistral-7B-Instruct-v0.1
#    - tiiuae/falcon-7b-instruct
#
